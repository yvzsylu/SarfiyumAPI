{
  "Logging": {
    "LogLevel": {
      // Yayın hattının ayrıntısını görmek için "Debug" yap:
      // [SOCKET_IN] her paket, [PERF] her yayın turu, watchdog denemeleri, gruplama kararları.
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // ⚠️ EN ÖNEMLİ AYAR.
  // appsettings.json içindeki connection string CANLI veritabanına bakıyor. Burada
  // ezilmeseydi lokal testler canlı veriyi bozardı. Development ortamında bu dosya
  // appsettings.json'ın üzerine geçtiği için `dotnet run` her zaman LOKAL DB kullanır.
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=SarfiyumDB_Local;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },

  // Lokal sahte piyasa verisi (Datshop simülasyonu).
  "MockFeed": {
    // Paket üretim aralığı. Datshop da saniyede birkaç paket gönderir; bu değerin
    // BroadcastIntervalMs'ten küçük olması, tick'in paketleri birleştirmesini (coalescing)
    // lokalde gerçekten test etmeyi sağlar.
    "PacketIntervalMs": 400,

    // true yapılırsa hiç paket üretilmez → "piyasa kapalı" senaryosu.
    // Yayın döngüsünün boşa dönmesini ve hiç mesaj gitmemesini test etmek için.
    "Paused": false,

    // Fiyat oynaklığı çarpanı. Büyütmek flash efektlerini ve delta trafiğini artırır.
    "Volatility": 1.0
  },

  "SocketServer": {
    // Yayın tick aralığı. Canlıdaki varsayılanla aynı tutulmalı ki test edilen
    // davranış canlıdakiyle örtüşsün.
    "BroadcastIntervalMs": 1000
  }
}
